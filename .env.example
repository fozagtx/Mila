AWS_REGION=us-west-2
AWS_DEFAULT_REGION=us-west-2

# IAM access keys from the AWS console (IAM → Users → Security credentials → Access keys).
# Do not commit this file. Next.js loads .env.local automatically.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Amazon Nova on Bedrock (US inference profile). Enable the model in Bedrock model access first.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Local AgentCore runtime (npm run agentcore:dev). Leave empty to call Bedrock in-process from Next.js.
AGENTCORE_RUNTIME_URL=http://localhost:8080

# After deploy, set the runtime ARN. Unset AGENTCORE_RUNTIME_URL in production.
# AGENTCORE_RUNTIME_ARN=
# AGENTCORE_QUALIFIER=DEFAULT
